{
  "tests": [
    {
      "name": "single_track",
      "input": {
        "audio": "https://github.com/runpod-workers/sample-inputs/raw/main/audio/gettysburg.wav",
        "model": "turbo",
        "transcription": "plain_text"
      },
      "timeout": 600000
    },
    {
      "name": "multi_track_batched",
      "input": {
        "audios": [
          "https://github.com/runpod-workers/sample-inputs/raw/main/audio/Arthur.mp3",
          "https://github.com/runpod-workers/sample-inputs/raw/main/audio/NM014.mp3",
          "https://github.com/runpod-workers/sample-inputs/raw/main/audio/accent.mp3"
        ],
        "model": "turbo",
        "transcription": "plain_text"
      },
      "timeout": 300000
    },
    {
      "name": "multi_track_corrected",
      "input": {
        "audios": [
          "https://github.com/runpod-workers/sample-inputs/raw/main/audio/gettysburg.wav",
          "https://github.com/runpod-workers/sample-inputs/raw/main/audio/NM014.mp3"
        ],
        "model": "turbo",
        "transcription_corrector": true
      },
      "timeout": 300000
    },
    {
      "name": "sequential_srt",
      "input": {
        "audio": "https://github.com/runpod-workers/sample-inputs/raw/main/audio/accent.mp3",
        "model": "turbo",
        "transcription": "srt",
        "batched": false
      },
      "timeout": 300000
    },
    {
      "name": "translate",
      "input": {
        "audio": "https://github.com/runpod-workers/sample-inputs/raw/main/audio/gettysburg.wav",
        "model": "base",
        "transcription": "plain_text",
        "translate": true
      },
      "timeout": 300000
    }
  ],
  "config": {
    "gpuTypeId": "NVIDIA RTX 4000 Ada Generation",
    "gpuCount": 1,
    "env": [
      { "key": "MAX_CONCURRENCY", "value": "4" },
      { "key": "PUNC_CHUNK_SIZE", "value": "120" }
    ],
    "allowedCudaVersions": ["12.8", "12.7", "12.6", "12.5", "12.4"]
  }
}
